# Supabase project credentials.
# Local development: run `npx supabase start` and copy "API URL" and "anon key"
# from its output (or `npx supabase status`).
# Production: Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
